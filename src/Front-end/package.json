    "nh-common:build:production": "ng build nh-common --configuration=production",
    "nh-toastr:analyze": "ng build nh-toastr --stats-json",
    "nh-toastr:build": "ng build nh-toastr --configuration=development",
    "nh-toastr:build:production": "ng build nh-toastr --configuration=production"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.28",
