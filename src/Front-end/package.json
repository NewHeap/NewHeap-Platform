{
  "name": "libraries",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:test-app": "ng serve test-app",
    "test-app:serve:ssr": "node dist/test-app/server/server.mjs",
    "test-app:run:development": "ng build test-app --configuration=development && node ./dist/test-app/server/server.mjs",
    "test-app:build:staging": "ng build test-app --configuration=staging && node .\\projects\\test-app\\web-config-transformer.js environment=staging && node .\\projects\\test-app\\robots-txt-transformer.js environment=staging",
    "test-app:build:production": "ng build test-app --configuration=production && node .\\projects\\test-app\\web-config-transformer.js environment=production && node .\\projects\\test-app\\robots-txt-transformer.js environment=production",
    "nh-common:analyze": "ng build nh-common --stats-json",
    "nh-common:build": "ng build nh-common --configuration=development",
    "nh-common:build:production": "ng build nh-common --configuration=production",
    "nh-common:publish": "ng build nh-common --configuration=production && npm publish ./dist/nh-common"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/cdk": "^19.0.3",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/localize": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/platform-server": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@angular/ssr": "^19.0.0",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@ngx-translate/core": "^16.0.3",
    "@ngx-translate/http-loader": "^16.0.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.57.2",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.2",
    "@opentelemetry/instrumentation-express": "^0.47.1",
    "@opentelemetry/instrumentation-http": "^0.57.2",
    "@opentelemetry/instrumentation-redis-4": "^0.46.1",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@swimlane/ngx-datatable": "^21.0.0-alpha.0",
    "@types/luxon": "^3.4.2",
    "axios": "^1.7.9",
    "express": "^4.18.2",
    "js-base64": "^3.7.7",
    "luxon": "^3.5.0",
    "ngx-bootstrap-multiselect": "^4.0.0",
    "ngx-cookie-service": "^19.0.0",
    "ngx-cookie-service-ssr": "^19.0.0",
    "ngx-toastr": "^19.0.0",
    "node-fetch": "^3.3.2",
    "rxjs": "~7.8.0",
    "tough-cookie": "^4.1.4",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/tough-cookie": "^4.0.5",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.0.0",
    "typescript": "~5.6.3"
  }
}
