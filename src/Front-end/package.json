{
  "name": "libraries",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "npm run nh-common:build && npm run nh-toastr:build",
    "build:production": "npm run nh-common:build:production && npm run nh-toastr:build:production",
    "test": "ng test nh-common --watch=false",
    "nh-common:analyze": "ng build nh-common --stats-json",
