{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "nh-common": {
      "projectType": "library",
      "root": "projects/nh-common",
      "sourceRoot": "projects/nh-common/src",
      "prefix": "nh-common",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/nh-common/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/nh-common/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/nh-common/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/nh-common/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "test-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/test-app",
      "sourceRoot": "projects/test-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "stylePreprocessorOptions": {
              "sass": {
                "silenceDeprecations": ["mixed-decls", "color-functions", "global-builtin", "import"]
              }
            },
            "preserveSymlinks": true,
            "outputPath": "dist/test-app",
            "outputMode": "server",
            "index": "projects/test-app/src/index.html",
            "browser": "projects/test-app/src/main.ts",
            "polyfills": [
              "zone.js",
              "@angular/localize/init"
            ],
            "tsConfig": "projects/test-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/test-app/src/favicon.ico",
              "projects/test-app/src/assets",
              "projects/test-app/src/web.config",
              "projects/test-app/src/sitemap.xml",
              "projects/test-app/src/robots.txt",
              "projects/test-app/src/bin",
              {
                "glob": "*",
                "input": "node_modules/font-awesome/fonts/",
                "output": ""
              }
            ],
            "styles": [
              "projects/test-app/src/styles.scss"
            ],
            "scripts": [
            ],
            "server": "projects/test-app/src/main.server.ts",
            "ssr": {
              "entry": "projects/test-app/server.ts",
              "experimentalPlatform": "node"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2000000kb",
                  "maximumError": "4000000kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/test-app/src/environments/environment.ts",
                  "with": "projects/test-app/src/environments/environment.production.ts"
                }
              ],
              "outputHashing": "all"
            },
            "staging": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2000000kb",
                  "maximumError": "4000000kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/test-app/src/environments/environment.ts",
                  "with": "projects/test-app/src/environments/environment.staging.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/test-app/src/environments/environment.ts",
                  "with": "projects/test-app/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "test-app:build:production"
            },
            "staging": {
              "buildTarget": "test-app:build:staging"
            },
            "development": {
              "buildTarget": "test-app:build:development"
            }
          },
          "options": {
            "port": 4200
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "test-app:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/test-app/src/favicon.ico",
              "projects/test-app/src/assets"
            ],
            "styles": [
              "projects/test-app/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
