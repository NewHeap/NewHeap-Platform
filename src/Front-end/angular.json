{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "nh-common": {
      "projectType": "library",
      "root": "projects/nh-common",
      "sourceRoot": "projects/nh-common/src",
      "prefix": "nh-common",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/nh-common/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/nh-common/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/nh-common/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/nh-common/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "nh-toastr": {
      "projectType": "library",
      "root": "projects/nh-toastr",
      "sourceRoot": "projects/nh-toastr/src",
      "prefix": "nh-toastr",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/nh-toastr/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/nh-toastr/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/nh-toastr/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/nh-toastr/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
