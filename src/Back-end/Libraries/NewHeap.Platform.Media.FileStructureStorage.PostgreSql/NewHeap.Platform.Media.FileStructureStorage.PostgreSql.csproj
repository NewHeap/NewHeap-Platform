<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>NewHeap.Platform.Media.FileStructureStorage.PostgreSql</PackageId>
        <Copyright>NewHeap B.V.</Copyright>
        <Title>NewHeap Media PostgreSQL FileStructure Storage</Title>
        <PackageDescription>PostgreSQL file-structure persistence, registration, and migrations for NewHeap Platform media libraries.</PackageDescription>
        <PackageTags>newheap platform media storage entity-framework postgresql</PackageTags>
        <RootNamespace>NewHeap.Media.FileStructureStorage.PostgreSql</RootNamespace>
        <IsPackable>True</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NewHeap.Platform.Media.Core\NewHeap.Platform.Media.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    </ItemGroup>

</Project>
