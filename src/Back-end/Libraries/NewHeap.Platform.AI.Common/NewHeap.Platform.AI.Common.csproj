<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>NewHeap.Platform.AI.Common</PackageId>
    <Copyright>NewHeap B.V.</Copyright>
    <Title>NewHeap AI Common</Title>
    <PackageDescription>Provider-neutral AI tool contracts, guarded invocation, and Microsoft.Extensions.AI adapters for NewHeap Platform applications.</PackageDescription>
    <PackageTags>newheap platform ai tools agents microsoft-extensions-ai</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NewHeap.Platform.Common\NewHeap.Platform.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NewHeap.Platform.AI.Mcp" />
    <!-- The adapter passes the provider exception of a failed model call on as an inner exception. -->
    <InternalsVisibleTo Include="NewHeap.Platform.AI.AgentFramework" />
    <InternalsVisibleTo Include="NewHeap.Platform.AI.AspNet.Common" />
    <InternalsVisibleTo Include="NewHeap.Platform.AI.AspNet.Mvc" />
    <InternalsVisibleTo Include="NewHeap.Platform.AI.Chat" />
    <InternalsVisibleTo Include="NewHeap.Platform.AI.Chat.AspNet" />
    <!-- The AG-UI endpoint captures the person of a turn that outlives its request, as the assistant endpoints do. -->
    <InternalsVisibleTo Include="NewHeap.Platform.AI.Chat.AGUI" />
    <!-- The agent builder's tests stand in for the gateway's resources (INhAiGatewayResources). -->
    <InternalsVisibleTo Include="NewHeap.Platform.AI.Chat.Tests" />
  </ItemGroup>
</Project>
