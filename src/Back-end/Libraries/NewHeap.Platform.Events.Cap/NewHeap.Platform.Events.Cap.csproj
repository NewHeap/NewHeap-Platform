<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Title>NewHeap Platform Events CAP</Title>
        <Copyright>NewHeap B.V.</Copyright>
        <PackageProjectUrl>https://github.com/NewHeap/NewHeap-Platform</PackageProjectUrl>
        <RepositoryUrl>https://github.com/NewHeap/NewHeap-Platform</RepositoryUrl>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <!-- If all members are not documented, you can disable the compiler warnings -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <IncludeSymbols>True</IncludeSymbols>
        <EmbedAllSources>True</EmbedAllSources>
        <DebugType>Embedded</DebugType>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageIcon>NH_logo.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="DotNetCore.CAP" />
      <PackageReference Include="DotNetCore.CAP.SqlServer" Aliases="CapSqlServer" />
      <PackageReference Include="DotNetCore.CAP.PostgreSql" Aliases="CapPostgreSql" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\NewHeap.Platform.AspNet.Common\NewHeap.Platform.AspNet.Common.csproj" />
      <ProjectReference Include="..\NewHeap.Platform.Common\NewHeap.Platform.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\Assets\NH_logo.png">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
        <Link>NH_logo.png</Link>
      </None>
    </ItemGroup>

</Project>
