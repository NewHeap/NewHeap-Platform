<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Title>NewHeap Platform Events CAP</Title>
        <PackageDescription>CAP-based transactional event publishing with SQL Server and PostgreSQL integrations for NewHeap Platform applications.</PackageDescription>
        <PackageTags>newheap platform events cap messaging sql-server postgresql</PackageTags>
        <Copyright>NewHeap B.V.</Copyright>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <!-- If all members are not documented, you can disable the compiler warnings -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="DotNetCore.CAP" />
      <PackageReference Include="DotNetCore.CAP.SqlServer" Aliases="CapSqlServer" />
      <PackageReference Include="DotNetCore.CAP.PostgreSql" Aliases="CapPostgreSql" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\NewHeap.Platform.AspNet.Common\NewHeap.Platform.AspNet.Common.csproj" />
      <ProjectReference Include="..\NewHeap.Platform.Common\NewHeap.Platform.Common.csproj" />
    </ItemGroup>
</Project>
