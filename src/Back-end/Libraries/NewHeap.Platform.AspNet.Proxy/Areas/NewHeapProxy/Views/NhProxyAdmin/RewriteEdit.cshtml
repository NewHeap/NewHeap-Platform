@model NhProxyRewriteEditorModel
@{
    ViewData["Title"] = Model.IsNew ? "Create rewrite" : "Edit rewrite";
}
<div class="heading"><div><a asp-action="Rewrites">Back to rewrites</a><h1>@ViewData["Title"]</h1><p class="muted">Match a request and forward it to one backend destination.</p></div></div>
<div class="editor"><form asp-action="RewriteEdit" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden" /><input asp-for="Revision" type="hidden" /><input asp-for="RedirectRevision" type="hidden" /><input asp-for="IsNew" type="hidden" /><input asp-for="ClusterId" type="hidden" />
    <div asp-validation-summary="All" class="notice" role="alert"></div>
    <div class="card"><h2>Request matching</h2><div class="grid">
        <div class="field"><label asp-for="Name">Name</label><input asp-for="Name" maxlength="200" /></div>
        <div class="field"><label asp-for="Path">Path template</label><input asp-for="Path" placeholder="/api/{**rest}" /><p class="help">Use route captures such as {id:int} or {**rest}. Leave empty only when restricting hosts.</p></div>
        <div class="field"><label asp-for="Hosts">Hosts</label><input asp-for="Hosts" placeholder="api.example.com, *.example.com" /><p class="help">Comma-separated; optional ports. Empty accepts any host.</p></div>
        <div class="field"><label asp-for="Methods">HTTP methods</label><input asp-for="Methods" placeholder="GET, POST" /><p class="help">Empty accepts any method.</p></div>
        <div class="field"><label asp-for="Priority">Priority</label><input asp-for="Priority" /></div>
        <div class="check"><input asp-for="Enabled" /><label asp-for="Enabled">Enabled</label></div>
    </div></div>
    <div class="card"><h2>Backend destination</h2><p class="muted">A destination can be shared. Changing its address or advanced settings affects every rule using it.</p>
        @if (!Model.AvailableClusters.IsEmpty)
        {
            <div class="field"><label asp-for="SelectedClusterId">Destination</label><div class="actions"><select asp-for="SelectedClusterId">
                @if (!Model.AvailableClusters.Any(cluster => cluster.Id == Model.ClusterId))
                {
                    <option value="@Model.ClusterId">New destination</option>
                }
                @foreach (var cluster in Model.AvailableClusters)
                {
                    <option value="@cluster.Id">@cluster.Name</option>
                }
            </select><button type="submit" name="operation" value="cluster" formnovalidate>Load destination</button></div><p class="help">Load an existing destination before editing or testing its settings.</p></div>
        }
        <div class="grid"><div class="field"><label asp-for="ClusterName">Destination name</label><input asp-for="ClusterName" /></div><div class="field"><label asp-for="DestinationAddress">Backend URL</label><input asp-for="DestinationAddress" placeholder="https://backend.example/base/" /><p class="help">Absolute HTTP(S) URL, optionally with a base path. Do not point this back at the matching proxy URL.</p></div></div>
    </div>
    <div class="card"><h2>Path transformation</h2><p class="muted">The backend base path is prepended after request transforms. Incoming queries are kept unless changed in advanced transforms.</p><div class="grid">
        <div class="field"><label asp-for="PathOperation">Operation</label><select asp-for="PathOperation"><option value="">Keep incoming path</option><option value="AddPrefix">Add prefix</option><option value="RemovePrefix">Remove prefix</option><option value="Set">Replace path</option><option value="Pattern">Build from route captures</option></select></div>
        <div class="field"><label asp-for="PathValue">Path value</label><input asp-for="PathValue" placeholder="/projects/{**rest}" /></div>
    </div></div>
    <div class="card"><details><summary>Advanced matching, transforms and policies</summary>
        <p class="help">Edit headers and queryParameters under match, additional ordered transforms, authorizationPolicy, corsPolicy, rateLimiterPolicy and requestTimeout. The fields above override id, name, enabled, priority, clusterId, path, hosts and methods. The path operation above runs before this transform list. Enum names and numeric values are accepted; unknown fields are rejected.</p>
        <div class="field"><label asp-for="AdvancedRuleJson">Advanced rule (JSON)</label><textarea asp-for="AdvancedRuleJson" rows="14" spellcheck="false"></textarea></div>
        <p class="help">For example, add {"kind":"query","name":"source","operation":"Set","value":"proxy"} to transforms. Header and query matching use name, mode, values and isCaseSensitive.</p>
        <div class="field"><label asp-for="AdvancedClusterJson">Advanced destination (JSON)</label><textarea asp-for="AdvancedClusterJson" rows="10" spellcheck="false"></textarea><p class="help">Configure activityTimeout, activeHealthCheck and passiveHealthCheck here. Durations use hh:mm:ss. The destination name and URL fields above take precedence.</p></div>
    </details></div>
    <div class="card"><h2>Test this draft</h2><p class="muted">Test against all saved managed rules, including redirects that take precedence. No changes are saved and no backend request or health probe is sent.</p>
        <div class="grid"><div class="field"><label asp-for="TestUrl">Request URL</label><input asp-for="TestUrl" placeholder="https://public.example/api/projects?source=test" /></div><div class="field"><label asp-for="TestMethod">Request method</label><input asp-for="TestMethod" /></div></div>
        <div class="field"><label asp-for="TestHeadersJson">Synthetic request headers (JSON)</label><textarea asp-for="TestHeadersJson" rows="3" spellcheck="false"></textarea><p class="help">Example: {"X-Mode":["preview"]}. Administrator cookies and credentials are never used. Secret and protected headers are rejected.</p></div>
        <div class="check"><input asp-for="SimulateEnabled" /><label asp-for="SimulateEnabled">Simulate this draft as enabled</label></div>
        <button type="submit" name="operation" value="test">Test draft</button>
        @if (Model.TestResult is { } result)
        {
            <div class="notice test-result" role="status">
                <strong>@result.Outcome</strong>
                <p>Tested rewrite revision @result.TestedRevisions.Rewrite · redirect revision @result.TestedRevisions.Redirect</p>
                @if (result.SelectedRuleId is { } selected)
                {
                    <p>@(selected == Model.Id ? "This draft is selected." : "Another saved rule takes precedence.") Rule: <code>@selected</code></p>
                }
                @if (result.Rewrite is { } rewrite)
                {
                    <p>Backend request: <code class="rule-path">@rewrite.TargetUrl.AbsoluteUri</code></p>
                    @foreach (var value in result.RouteValues)
                    {
                        <p>Route value <code>@value.Key</code>: <code>@value.Value</code></p>
                    }
                    @foreach (var header in rewrite.SafeRequestHeaders)
                    {
                        <p>Header <code>@header.Key</code>: <code>@string.Join(", ", header.Value)</code></p>
                    }
                    @if (!rewrite.UnevaluatedResponseHeaderTransforms.IsEmpty)
                    {
                        <p>@rewrite.UnevaluatedResponseHeaderTransforms.Length response header transform(s) require an upstream response and are not evaluated.</p>
                    }
                }
                @if (result.Redirect is { } redirect)
                {
                    <p>A redirect takes precedence: HTTP @((int)redirect.Status) to <code class="rule-path">@redirect.Location</code>.</p>
                }
                @if (result.Outcome == NhProxyTestOutcome.NoMatch)
                {
                    <p>@(!Model.Enabled && !Model.SimulateEnabled ? "This draft is disabled." : "No enabled managed rule matches this request. Check path, host, method, header and query conditions.")</p>
                }
                @if (result.Outcome == NhProxyTestOutcome.ReservedAdministrationPath)
                {
                    <p>The administration path is reserved and bypasses managed rules.</p>
                }
                <p class="help">Preview checks matching and standard transforms. It does not verify connectivity, health, authorization, rate limiting, upstream responses or host-specific YARP customizations and other configuration sources.</p>
            </div>
        }
    </div>
    <div class="actions"><a asp-action="Rewrites">Cancel</a><button class="primary" type="submit" name="operation" value="save">Save and activate</button></div>
</form></div>
