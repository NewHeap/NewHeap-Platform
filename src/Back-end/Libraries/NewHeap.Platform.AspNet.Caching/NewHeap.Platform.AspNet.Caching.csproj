<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>

        <PackageId>NewHeap.Platform.AspNet.Caching</PackageId>
        <Copyright>NewHeap B.V.</Copyright>
        <Title>NewHeap AspNet Caching</Title>
        <PackageDescription>ASP.NET Core caching integration for NewHeap Platform using FusionCache and SQLite-backed cache storage.</PackageDescription>
        <PackageTags>newheap platform aspnetcore caching fusioncache sqlite</PackageTags>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="NeoSmart.Caching.Sqlite.AspNetCore" />
      <PackageReference Include="SQLitePCLRaw.bundle_green" />
      <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
      <PackageReference Include="ZiggyCreatures.FusionCache" />
      <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.NewtonsoftJson" />
    </ItemGroup>

</Project>
