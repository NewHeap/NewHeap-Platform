<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>NewHeap.Platform.AI.Chat.SqlServer</PackageId>
    <Copyright>NewHeap B.V.</Copyright>
    <Title>NewHeap AI Chat SQL Server</Title>
    <PackageDescription>SQL Server persistence, registration and migrations for NewHeap AI assistant conversations.</PackageDescription>
    <PackageTags>newheap platform ai chat assistant entity-framework sqlserver</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NewHeap.Platform.AI.Chat\NewHeap.Platform.AI.Chat.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NewHeap.Platform.AI.Chat.Tests" />
  </ItemGroup>
</Project>
