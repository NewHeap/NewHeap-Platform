<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>NewHeap.Platform.AI.AspNet.Common</PackageId>
    <Copyright>NewHeap B.V.</Copyright>
    <Title>NewHeap AI ASP.NET Common</Title>
    <PackageDescription>ASP.NET Core actor, authorization, active-division, and capability context integration for NewHeap AI.</PackageDescription>
    <PackageTags>newheap platform ai aspnetcore authorization context divisions capabilities</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NewHeap.Platform.AI.AspNet.Mvc" />
    <InternalsVisibleTo Include="NewHeap.Platform.AI.Chat.AspNet" />
    <InternalsVisibleTo Include="NewHeap.Platform.AI.Chat.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NewHeap.Platform.AI.Common\NewHeap.Platform.AI.Common.csproj" />
    <ProjectReference Include="..\NewHeap.Platform.AI.Mcp\NewHeap.Platform.AI.Mcp.csproj" />
    <ProjectReference Include="..\NewHeap.Platform.AspNet.Common\NewHeap.Platform.AspNet.Common.csproj" />
  </ItemGroup>
</Project>
