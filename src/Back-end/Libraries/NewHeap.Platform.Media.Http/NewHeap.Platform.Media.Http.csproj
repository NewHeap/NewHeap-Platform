<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>NewHeap.Platform.Media.Http</PackageId>
        <Copyright>NewHeap B.V.</Copyright>
        <Title>NewHeap Media Http</Title>
        <PackageDescription>Typed ASP.NET Core HTTP endpoints and route composition for NewHeap Platform media libraries.</PackageDescription>
        <PackageTags>newheap platform media aspnetcore http api</PackageTags>
        <RootNamespace>NhMedia.Http</RootNamespace>
        <IsPackable>True</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NewHeap.Platform.Media.Core\NewHeap.Platform.Media.Core.csproj" />
    </ItemGroup>

</Project>
