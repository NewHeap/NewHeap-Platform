<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>NewHeap.Platform.AI.AspNet.Mvc</PackageId>
    <Copyright>NewHeap B.V.</Copyright>
    <Title>NewHeap AI ASP.NET MVC API Bridge</Title>
