  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NewHeap.Platform.AI.Common\NewHeap.Platform.AI.Common.csproj" />
    <ProjectReference Include="..\NewHeap.Platform.AI.AspNet.Common\NewHeap.Platform.AI.AspNet.Common.csproj" />
  </ItemGroup>
</Project>
