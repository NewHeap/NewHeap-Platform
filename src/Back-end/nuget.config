<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- Define the package sources, nuget.org and contoso.com. -->
	<!-- `clear` ensures no additional sources are inherited from another config file. -->
	<packageSources>
		<clear />
		<!-- `key` can be any identifier for your source. -->
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="NewHeap-Platform" value="https://pkgs.dev.azure.com/NewHeap/NewHeap-Platform/_packaging/NewHeap-Platform/nuget/v3/index.json" />
	</packageSources>

	<!-- Define mappings by adding package patterns beneath the target source. -->
	<!-- Contoso.* packages and NuGet.Common will be restored from contoso.com,
       everything else from nuget.org. -->
	<packageSourceMapping>
		<!-- key value for <packageSource> should match key values from <packageSources> element -->
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
		<packageSource key="NewHeap-Platform">
			<package pattern="NewHeap.*" />
		</packageSource>
	</packageSourceMapping>
</configuration>