<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- minPublishAgeHours (NuGet 8.0, .NET SDK 11.0.100+) keeps dotnet package add/update and floating versions
         from selecting a third-party version published less than three days ago. Pinned versions restore unchanged,
         and older SDKs ignore the attribute. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" minPublishAgeHours="72" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <!-- NewHeap's own packages are adopted on the day they are released. -->
  <minPublishAgeExceptions>
    <package pattern="NewHeap.*" />
  </minPublishAgeExceptions>
</configuration>
