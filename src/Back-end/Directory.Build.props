<Project>
 <PropertyGroup>
   <LangVersion>latestMajor</LangVersion>
   <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
   <Authors>NewHeap contributors</Authors>
   <PackageProjectUrl>https://github.com/NewHeap/NewHeap-Platform</PackageProjectUrl>
   <RepositoryUrl>https://github.com/NewHeap/NewHeap-Platform</RepositoryUrl>
   <RepositoryType>git</RepositoryType>
   <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
   <PublishRepositoryUrl>true</PublishRepositoryUrl>
   <UseLocalNewHeapProjects Condition="'$(UseLocalNewHeapProjects)' == ''">true</UseLocalNewHeapProjects>
 </PropertyGroup>

 <PropertyGroup Condition="'$(IsPackable)' != 'false'">
   <PackageIcon>NH_logo.png</PackageIcon>
   <IncludeSymbols>true</IncludeSymbols>
   <SymbolPackageFormat>snupkg</SymbolPackageFormat>
   <DebugType>portable</DebugType>
   <EmbedAllSources>false</EmbedAllSources>
   <EmbedUntrackedSources>true</EmbedUntrackedSources>
 </PropertyGroup>

 <ItemGroup>
   <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE"
         Pack="true"
         PackagePath=""
         Visible="false" />
   <None Include="$(MSBuildThisFileDirectory)..\..\NOTICE"
         Pack="true"
         PackagePath=""
         Visible="false" />
   <None Include="$(MSBuildThisFileDirectory)..\..\THIRD-PARTY-NOTICES.md"
         Pack="true"
         PackagePath=""
         Visible="false" />
   <None Include="$(MSBuildThisFileDirectory)Assets\NH_logo.png"
         Pack="true"
         PackagePath=""
         Visible="false" />
 </ItemGroup>
</Project>
