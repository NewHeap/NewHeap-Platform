{
  "Database": {
    "Provider": "postgresql",
    "ConnectionStringName": "sample-project-management"
  },
  "ConnectionStrings": {
    "NewHeapDiagnosticsReadOnly": "${Secrets:ConnectionStrings:NewHeapDiagnosticsReadOnly}"
  },
  "NewHeap": {
    "PlatformCommon": {
      "Settings": {
        "CollectionProcessingDefaultItemsPerPage": 20,
        "CollectionProcessingDefaultMaxItemsPerPage": 1000,
        "CollectionProcessingDeadlockMaxAttempts": 5
      },
      "MicrosoftAuthSettings": {
        "ClientId": "${Secrets:NewHeap:PlatformCommon:MicrosoftAuthSettings:ClientId}",
        "ClientSecret": "${Secrets:NewHeap:PlatformCommon:MicrosoftAuthSettings:ClientSecret}",
        "TenantId": "common",
        "CallbackUrl": "https://sample-project-management-api.dev.localhost:5281/auth/microsoft/callback",
        "ProfileEndpoint": "https://graph.microsoft.com/v1.0/me",
        "AuthDomains": [
          "sample.local"
        ]
      },
      "MailServiceSettings": {
        "Transport": "smtp",
        "Host": "localhost",
        "Port": 1025,
        "EnableSsl": false,
        "User": "",
        "Password": "",
        "FromEmail": "no-reply@sample.local",
        "FromDisplayName": "Sample Project Management",
        "IsSendRescritedActive": true,
        "RestrictedEmailWhitelist": [
          "@sample.local"
        ]
      },
      "AppSecretsDirectoryPath": "%SAMPLE_PROJECT_MANAGEMENT_APP_SECRETS_ROOT%\\SampleProjectManagement"
    },
    "PlatformAspNetCommon": {
      "Settings": {
        "DefaultCulture": "nl-NL",
        "SupportedCultures": [
          "nl-NL",
          "en-US"
        ],
        "AllowedOrigins": [
          "http://localhost:4210",
          "http://localhost:4220",
          "http://sample-project-management-management.dev.localhost:4210",
          "http://sample-project-management-workspace.dev.localhost:4220",
          "http://sample-project-management-management-sample-project-management.dev.localhost:4210",
          "http://sample-project-management-workspace-sample-project-management.dev.localhost:4220"
        ],
        "SelfBaseUrl": "https://sample-project-management-api.dev.localhost:5281",
        "RecurringJobsEnabled": false
      },
      "Authorization": {
        "JWT": {
          "Token": {
            "Key": "${Secrets:NewHeap:PlatformAspNetCommon:Authorization:JWT:Token:Key}",
            "Issuer": "https://sample-project-management-api.dev.localhost:5281",
            "ValidAudience": "https://sample-project-management-api.dev.localhost:5281"
          }
        }
      },
      "DbLogServiceSettings": {
        "RootDirectory": "logs",
        "ErrorMailAddresses": []
      }
    }
  },
  "ApiClients": {
    "SampleProjectManagement": {
      "BaseAddress": "https://sample-project-management-api.dev.localhost:5281"
    }
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
